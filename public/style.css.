
* {
  box-sizing: border-box;
}

:root {
  color-scheme: dark;
  --background: #0b0f0d;
  --panel: #151c18;
  --gold: #f5c542;
  --green: #18b66a;
  --text: #f5f5f5;
  --muted: #b8c1bb;
  --border: #303b33;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--background);
  color: var(--text);
  line-height: 1.6;
}

.topbar {
  padding: 24px 14px;
  text-align: center;
  background: #111914;
  border-bottom: 2px solid var(--gold);
}

.topbar h1 {
  margin: 0;
  color: var(--gold);
  font-size: clamp(24px, 6vw, 36px);
}

.topbar p {
  color: var(--muted);
}

nav {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 18px;
}

button {
  border: 0;
  border-radius: 8px;
  padding: 12px 16px;
  background: var(--green);
  color: #06150c;
  font-weight: bold;
  cursor: pointer;
  margin: 5px 0;
}

button:hover {
  filter: brightness(1.1);
}

nav button {
  background: #28362d;
  color: white;
  border: 1px solid #465448;
}

.container {
  width: min(100% - 24px, 850px);
  margin: 24px auto;
}

.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 5px 20px #0003;
}

.panel h2 {
  color: var(--gold);
  margin-top: 0;
}

.panel h3 {
  margin-top: 25px;
  color: #7ce5a9;
}

label {
  display: block;
  margin-top: 14px;
  font-weight: bold;
}

input,
select {
  display: block;
  width: 100%;
  padding: 13px;
  margin-top: 6px;
  border: 1px solid #48564b;
  border-radius: 8px;
  background: #0b110d;
  color: white;
  font-size: 16px;
}

input:focus,
select:focus {
  outline: 2px solid var(--gold);
}

.panel > button {
  width: 100%;
  margin-top: 16px;
}

.notice {
  margin-top: 14px;
  padding: 14px;
  background: #202d23;
  border-left: 4px solid var(--gold);
  border-radius: 6px;
  overflow-wrap: anywhere;
}

.odd-card,
.payment-card {
  background: #202a23;
  border: 1px solid #3b4b3e;
  border-radius: 9px;
  padding: 14px;
  margin: 12px 0;
  overflow-wrap: anywhere;
}

.odd-card strong {
  color: var(--gold);
}

.payment-card button {
  margin-right: 8px;
}

a {
  color: var(--gold);
}

[hidden] {
  display: none !important;
}

#paymentMessage,
#adminMessage,
#vipNotice {
  overflow-wrap: anywhere;
}

footer {
  padding: 20px 12px;
  text-align: center;
  color: var(--muted);
  border-top: 1px solid var(--border);
  font-size: 13px;
}

@media (max-width: 480px) {
  .panel {
    padding: 15px;
  }

  nav button {
    flex: 1 1 38%;
  }
}

