
"use strict";

// YUSUPHU ODDS VIP — public/app.js

const paymentNumbers = {
  "M-Pesa": "0793401886",
  "Airtel Money": "0692359311",
  "HaloPesa": "0613431930"
};

const $ = (id) => document.getElementById(id);

async function api(url, options = {}) {
  const response = await fetch(url, {
    ...options,
    headers: {
      "Content-Type": "application/json",
      ...(options.headers || {})
    },
    credentials: "same-origin"
  });

  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(data.message || "Ombi halijafanikiwa.");
  }

  return data;
}

function showMessage(id, message, success = false) {
  const element = $(id);
  if (!element) return;

  element.textContent = message;
  element.style.color = success ? "#7ce5a9" : "#ff9999";
}

function showSection(sectionId) {
  document.querySelectorAll("main section[id]").forEach((section) => {
    section.hidden = section.id !== sectionId;
  });

  if (sectionId === "home") loadOdds("free");
  if (sectionId === "vip") loadOdds("vip");
  if (sectionId === "admin") checkAdmin();
}

document.querySelectorAll("[data-section]").forEach((button) => {
  button.addEventListener("click", () => {
    showSection(button.dataset.section);
  });
});

// PAYMENT NETWORK NUMBERS
const methodSelect = $("paymentMethod");

if (methodSelect) {
  methodSelect.addEventListener("change", () => {
    const method = methodSelect.value;
    const number = paymentNumbers[method];
    const display = $("paymentNumber");

    if (!display) return;

    display.textContent = number
      ? `Mtandao: ${method} | Namba ya malipo: ${number} | Kiasi: TSh 5,000`
      : "Chagua mtandao ili kuona namba ya malipo.";
  });
}

// SUBMIT PAYMENT REFERENCE
const paymentButton = $("submitPayment");

if (paymentButton) {
  paymentButton.addEventListener("click", async () => {
    const name = $("customerName").value.trim();
    const phone = $("customerPhone").value.trim();
    const method = $("paymentMethod").value;
    const reference = $("paymentReference").value.trim();

    if (!name || !phone || !method || !reference) {
      showMessage(
        "paymentMessage",
        "Jaza jina, namba ya simu, mtandao na Payment Reference."
      );
      return;
    }

    paymentButton.disabled = true;
    paymentButton.textContent = "Inatuma...";

    try {
      const result = await api("/api/payment", {
        method: "POST",
        body: JSON.stringify({ name, phone, method, reference })
      });

      showMessage(
        "paymentMessage",
        result.message || "Ombi lako limetumwa. Subiri Admin akague malipo.",
        true
      );

      $("paymentReference").value = "";
    } catch (error) {
      showMessage("paymentMessage", error.message);
    } finally {
      paymentButton.disabled = false;
      paymentButton.textContent = "NIMEFANYA MALIPO";
    }
  });
}

// LOAD FREE AND VIP ODDS
async function loadOdds(type) {
  const container = $(type === "free" ? "freeOdds" : "vipOdds");
  if (!container) return;

  container.textContent = "Inapakia Odds...";

  try {
    const result = await api(`/api/odds?type=${type}`);
    const odds = Array.isArray(result) ? result : (result.odds || []);

    container.replaceChildren();

    if (!odds.length) {
      container.textContent = type === "free"
        ? "Bado hakuna Free Odds zilizowekwa."
        : "Bado hakuna VIP Odds zilizowekwa.";
      return;
    }

    odds.forEach((item) => {
      const card = document.createElement("div");
      card.className = "odd-card";

      const match = document.createElement("p");
      const matchTitle = document.createElement("strong");
      matchTitle.textContent = item.match || "Mechi";
      match.appendChild(matchTitle);

      const prediction = document.createElement("p");
      prediction.textContent = `Utabiri: ${item.prediction || item.pick || "-"}`;

      const odd = document.createElement("p");
      odd.textContent = `Odd: ${item.odd ?? "-"}`;

      card.append(match, prediction, odd);
      container.appendChild(card);
    });
  } catch (error) {
    container.textContent = "Imeshindikana kupakia Odds. Jaribu tena.";
  }
}

// VIP PAYMENT BUTTON
const vipPaymentButton = $("vipPaymentButton");

if (vipPaymentButton) {
  vipPaymentButton.addEventListener("click", () => {
    showSection("payment");
  });
}

// ADMIN LOGIN
const adminLoginButton = $("adminLoginButton");

if (adminLoginButton) {
  adminLoginButton.addEventListener("click", async () => {
    const password = $("adminPassword").value;

    if (!password) {
      showMessage("adminMessage", "Weka password ya Admin.");
      return;
    }

    adminLoginButton.disabled = true;

    try {
      const result = await api("/api/admin/login", {
        method: "POST",
        body: JSON.stringify({ password })
      });

      $("adminPassword").value = "";
      showMessage(
        "adminMessage",
        result.message || "Umeingia Admin.",
        true
      );

      await checkAdmin();
    } catch (error) {
      showMessage("adminMessage", error.message);
    } finally {
      adminLoginButton.disabled = false;
    }
  });
}

// CHECK ADMIN SESSION
async function checkAdmin() {
  try {
    const result = await api("/api/admin/me");
    const loggedIn = result.authenticated === true ||
      result.isAdmin === true ||
      result.loggedIn === true;

    $("adminLogin").hidden = loggedIn;
    $("adminDashboard").hidden = !loggedIn;

    if (loggedIn) {
      loadPayments();
    }
  } catch (error) {
    $("adminLogin").hidden = false;
    $("adminDashboard").hidden = true;
  }
}

// ADD ODDS
const addOddButton = $("addOddButton");

if (addOddButton) {
  addOddButton.addEventListener("click", async () => {
    const match = $("oddMatch").value.trim();
    const prediction = $("oddPrediction").value.trim();
    const odd = Number($("oddValue").value);
    const type = $("oddType").value;

    if (!match || !prediction || !Number.isFinite(odd) || odd <= 1) {
      showMessage(
        "adminMessage",
        "Weka mechi, utabiri na Odd iliyo kubwa kuliko 1."
      );
      return;
    }

    addOddButton.disabled = true;

    try {
      const result = await api("/api/admin/odds", {
        method: "POST",
        body: JSON.stringify({ match, prediction, odd, type })
      });

      showMessage(
        "adminMessage",
        result.message || "Odds imeongezwa.",
        true
      );

      $("oddMatch").value = "";
      $("oddPrediction").value = "";
      $("oddValue").value = "";

      await loadOdds(type);
    } catch (error) {
      showMessage("adminMessage", error.message);
    } finally {
      addOddButton.disabled = false;
    }
  });
}

// LOAD PAYMENT REQUESTS
async function loadPayments() {
  const container = $("adminPayments");
  if (!container) return;

  container.textContent = "Inapakia malipo...";

  try {
    const result = await api("/api/admin/payments");
    const payments = Array.isArray(result)
      ? result
      : (result.payments || []);

    container.replaceChildren();

    if (!payments.length) {
      container.textContent = "Hakuna maombi ya malipo kwa sasa.";
      return;
    }

    payments.forEach((payment) => {
      const card = document.createElement("div");
      card.className = "payment-card";

      const details = document.createElement("p");
      details.textContent =
        `Jina: ${payment.name || "-"} | Simu: ${payment.phone || "-"} | ` +
        `Mtandao: ${payment.method || "-"} | Reference: ${payment.reference || "-"} | ` +
        `Hali: ${payment.status || "PENDING"}`;

      card.appendChild(details);

      if (String(payment.status || "").toUpperCase() === "PENDING") {
        const approve = document.createElement("button");
        approve.textContent = "THIBITISHA MALIPO";

        approve.addEventListener("click", () => {
          updatePayment(payment.id, "approve");
        });

        const reject = document.createElement("button");
        reject.textContent = "KATAA";

        reject.addEventListener("click", () => {
          updatePayment(payment.id, "reject");
        });

        card.append(approve, reject);
      }

      container.appendChild(card);
    });
  } catch (error) {
    container.textContent = error.message;
  }
}

async function updatePayment(id, action) {
  if (!confirm(
    action === "approve"
      ? "Je, umethibitisha fedha zimeingia kweli?"
      : "Je, unataka kukataa ombi hili?"
  )) {
    return;
  }

  try {
    const result = await api(`/api/admin/payments/${encodeURIComponent(id)}/${action}`, {
      method: "POST",
      body: JSON.stringify({})
    });

    showMessage(
      "adminMessage",
      result.message || "Ombi limefanyiwa kazi.",
      true
    );

    await loadPayments();
  } catch (error) {
    showMessage("adminMessage", error.message);
  }
}

const loadPaymentsButton = $("loadPaymentsButton");

if (loadPaymentsButton) {
  loadPaymentsButton.addEventListener("click", loadPayments);
}

// ADMIN LOGOUT
const adminLogoutButton = $("adminLogoutButton");

if (adminLogoutButton) {
  adminLogoutButton.addEventListener("click", async () => {
    try {
      await api("/api/admin/logout", {
        method: "POST",
        body: JSON.stringify({})
      });

      $("adminDashboard").hidden = true;
      $("adminLogin").hidden = false;
      showMessage("adminMessage", "Umetoka kwenye Admin.", true);
    } catch (error) {
      showMessage("adminMessage", error.message);
    }
  });
}

// INITIAL PAGE
showSection("home");

